APP_NAME="NC5 Mail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mail_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Em producao usar 'database' (tabela jobs ja migrada) e ativar worker no supervisor.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em producao trocar MAIL_MAILER para 'smtp' e apontar para docker-mailserver (mail.nc5hubdigital.com.br).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@nc5hubdigital.com.br
MAIL_FROM_NAME="${APP_NAME}"

# IMAP (webklex/php-imap). Em producao SEMPRE IMAP_ENCRYPTION=ssl + IMAP_VALIDATE_CERT=true.
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=null
IMAP_PASSWORD=null
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap

# CORS: dominios permitidos separados por virgula. Ex: https://app.nc5hubdigital.com.br,https://mail.nc5hubdigital.com.br
CORS_ALLOWED_ORIGINS=https://app.nc5hubdigital.com.br,https://mail.nc5hubdigital.com.br

# Mailserver CLI (docker exec). Manter false ate ter permissao real do docker socket via www-data.
MAILSERVER_CLI_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
